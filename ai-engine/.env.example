# AI Engine Environment Variables

# Reddit API Credentials (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
RED DIT_USER_AGENT=LeadGen/1.0

# Twitter API Credentials (https://developer.twitter.com)
TWITTER_BEARER_TOKEN=your_bearer_token
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret

# LinkedIn Credentials (your personal account - use cautiously)
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# Server Configuration
AI_ENGINE_PORT=8000
